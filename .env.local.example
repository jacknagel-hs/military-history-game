NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Used by scripts/seed.ts to write
# content, bypassing RLS.
SUPABASE_SERVICE_ROLE_KEY=
# Mapbox public token (starts with "pk.") from account.mapbox.com/access-tokens
NEXT_PUBLIC_MAPBOX_TOKEN=
# Shared secret checked by /api/cron/seed-rounds — only needs to be set in
# Vercel; Vercel automatically sends it as a Bearer token on cron requests.
CRON_SECRET=
